# ArchScale — Module 1 Environment Configuration
# Copy this file to .env and adjust values as needed.

# Root directory for all storage (relative to project root)
STORAGE_ROOT=storage

# Sub-directories under STORAGE_ROOT
RAW_STORAGE_DIR=raw
PROCESSED_STORAGE_DIR=processed

# Maximum allowed upload file size in bytes (default: 20 MB)
MAX_UPLOAD_SIZE_BYTES=20971520

# Allowed file extensions (comma-separated, no spaces)
ALLOWED_EXTENSIONS=.txt,.pdf
