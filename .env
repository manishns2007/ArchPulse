# ArchScale — Environment Configuration

# ─────────────────────────────────────────────────────────
# Module 1 — Ingestion Storage
# ─────────────────────────────────────────────────────────

# Root directory for all storage (relative to project root)
STORAGE_ROOT=storage

# Sub-directories under STORAGE_ROOT
RAW_STORAGE_DIR=raw
PROCESSED_STORAGE_DIR=processed

# Maximum allowed upload file size in bytes (default: 20 MB)
MAX_UPLOAD_SIZE_BYTES=20971520

# Allowed file extensions (comma-separated, no spaces)
ALLOWED_EXTENSIONS=.txt,.pdf

# ─────────────────────────────────────────────────────────
# Module 2 — LLM Provider (Communication Understanding)
# ─────────────────────────────────────────────────────────

# Which LLM provider to use: gemini | openai | fake
# Use "fake" to run without any API key (tests, local dev)
LLM_PROVIDER=gemini

# Model name as understood by the selected provider
LLM_MODEL=gemini-3.6-flash

# API key for the selected provider — paste your real key here
LLM_API_KEY=AQ.Ab8RN6L2klCrGszQAIVT8E-qTzC6E9kdb7VJ_fOpKPosPHYMjA

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=30

# Retry attempts on transient LLM failures
LLM_MAX_RETRIES=2
